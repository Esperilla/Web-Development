{
  "name": "ictam-webapp",
  "version": "1.0.0",
  "description": "Aplicación web para ICTAM - Administradora de Portafolio de Servicios",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:css",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css",
    "build:css:watch": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch"
  },
  "keywords": ["ictam", "construccion", "arquitectura", "webapp"],
  "author": "ICTAM Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "multer": "^1.4.4",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "morgan": "^1.10.0",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "tailwindcss": "^3.3.3"
  }
}
